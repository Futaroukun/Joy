# ==========================================
# JOY BOT - ENVIRONMENT CONFIGURATION (.env)
# Salin file ini menjadi .env lalu isi data:
# cp .env.example .env
# ==========================================

# ── 👑 IDENTITAS OWNER & BOT ─────────────
# Masukkan nomor internasional tanpa tanda + (contoh: 628123456789)
DEVELOPER_NUMBER="628xxxxxxxxxx"
OWNER_NUMBER="628xxxxxxxxxx"
BOT_NUMBER="628xxxxxxxxxx"
BOT_NAME="Joy"
OWNER_NAME="Owner"

# ── 🤖 AI API KEYS ───────────────────────
# API Key OpenRouter untuk multi-model AI (.ai / .ax)
# Mendukung multiple key dipisah koma jika ingin rotasi otomatis
OPENROUTER_KEYS=""

# API Key Modelnyaw / OpenAI endpoint kustom
MODELNYAW_API_KEY=""
OPENAI_API_KEY=""

# Google Gemini API Key (.gemini)
GEMINI_API_KEY=""

# ── 🍪 COOKIES & CREDENTIALS ────────────
# Cookie akun Pixiv untuk download karya seni & R-18 (.pixiv / .pixivdl)
PIXIV_COOKIE=""

# Akun Scraper Elin AI Persona (.elin)
ELIN_USERNAME=""
ELIN_PASSWORD=""

# Akun Scraper Qwen Web AI (.qwen)
QWEN_EMAIL=""
QWEN_PASSWORD=""

# Akun Sfile Mobi (.sfile / .downloadsfile)
SFILE_EMAIL=""
SFILE_PASSWORD=""
